# Terraform working directories
**/.terraform/*

# Terraform state and plan files
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Keep .terraform.lock.hcl under version control.
